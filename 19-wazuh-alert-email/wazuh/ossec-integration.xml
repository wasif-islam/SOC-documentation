<!-- Add inside <ossec_config> in /var/ossec/etc/ossec.conf, then: systemctl restart wazuh-manager -->
<!-- Sends every alert of level 10 or higher to the n8n "Wazuh alert email" workflow -->
<integration>
  <name>custom-n8n</name>
  <hook_url>http://localhost:5678/webhook/wazuh-alerts</hook_url>
  <level>10</level>
  <alert_format>json</alert_format>
</integration>
