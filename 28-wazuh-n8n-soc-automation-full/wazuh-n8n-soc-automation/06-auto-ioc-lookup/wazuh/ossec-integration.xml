<!-- Add inside <ossec_config> in /var/ossec/etc/ossec.conf, then: systemctl restart wazuh-manager -->
<!-- Sends every alert of level 5 or higher to the n8n "Automatic IOC lookup" workflow.
     The workflow itself ignores alerts without a public source IP. -->
<integration>
  <name>custom-n8n</name>
  <hook_url>http://localhost:5678/webhook/wazuh-ioc</hook_url>
  <level>5</level>
  <alert_format>json</alert_format>
</integration>
